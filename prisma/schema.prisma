generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id    String @id @default(cuid())
  name  String
  color String @default("#6366f1")
  tasks Task[]
}

model Task {
  id     String   @id @default(cuid())
  title  String
  date   DateTime
  tripId String
  trip   Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
